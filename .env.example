# Telegram app details. Create these at https://my.telegram.org > API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Run `npm run login` once, then paste the printed value here. Keep it private.
TELEGRAM_SESSION=
# Public @username or numeric identifier of the ONE group/channel to monitor.
TELEGRAM_GROUP=@your_job_group

# Your candidate details, used in the email.
CANDIDATE_NAME=Your name
CANDIDATE_EMAIL=you@example.com
CANDIDATE_PORTFOLIO=https://github.com/your-handle
# A short, truthful summary used in the application email. Example: React, TypeScript, Node.js, REST APIs
CANDIDATE_HIGHLIGHTS=
CV_PATH=./cv.pdf

# `false` is the safe default: every new group message with an email is saved in queue/ for review, but nothing is sent.
# Set true when you want to email every address found in new messages from the selected group.
AUTO_SEND=false
# Set 0 for no daily cap. A positive number limits automatic sends per UTC day.
APPLICATION_LIMIT_PER_DAY=4

# SMTP mail account. For Gmail, use smtp.gmail.com / 465 / true and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=
MAIL_FROM=Your name <you@example.com>
